# ============================================================
# Unity .gitignore - JungleEscape (Unity 6000.4.6f1 / URP)
# Base template: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Extended for: Rider, VSCode, macOS, Windows, UPM
# ============================================================


# ====================
# Unity Generated
# ====================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*


# ====================
# Build Artifacts
# ====================
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app


# ====================
# Blender
# ====================
# Unity supports Blender asset imports; *.blend1 files do not need to be committed
*.blend1
*.blend1.meta


# ====================
# Crashlytics
# ====================
crashlytics-build.properties


# ====================
# TestRunner
# ====================
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*


# ====================
# Addressables
# ====================
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# Platform-specific content state files, e.g.:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*


# ====================
# Visual Scripting
# ====================
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta


# ====================
# IDE - Visual Studio
# ====================
.vs/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db


# ====================
# IDE - JetBrains Rider
# ====================
.idea/
*.sln.DotSettings
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*


# ====================
# IDE - VSCode
# ====================
.vscode/
*.code-workspace


# ====================
# IDE - Gradle
# ====================
.gradle/


# ====================
# OS - macOS
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes


# ====================
# OS - Windows
# ====================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump


# ====================
# Node / UPM
# ====================
node_modules/
package-lock.json


# ====================
# Asset Store Tools (uncomment if not used)
# ====================
# /[Aa]ssets/AssetStoreTools*

Assets/_Recovery/